SILICONFLOW_API_KEY=
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
SILICONFLOW_OCR_MODEL=deepseek-ai/DeepSeek-OCR

# OpenAI-compatible resume screening endpoint. COMPATIABLE is retained for
# compatibility with the current local configuration.
OPENAI_COMPATIABLE_URL=https://api.deepseek.com
OPENAI_API_KEY=
OPENAI_MODEL=deepseek-chat

# Optional OCR tuning
OCR_INPUT_DIR=resumes
OCR_OUTPUT_DIR=ocr_results
OCR_RENDER_DPI=144
OCR_RENDER_FORMAT=PNG
OCR_PAGE_CONCURRENCY=2
OCR_MAX_RETRIES=2
OCR_REQUEST_TIMEOUT_SECONDS=180
OCR_MAX_OUTPUT_TOKENS=4096

